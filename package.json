{
  "name": "effect-assistant-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @acme/demo-api --filter @acme/demo-web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "test": "pnpm --filter effect-assistant test && pnpm --filter @acme/demo-shared test && pnpm --filter @acme/demo-api test && pnpm --filter @acme/demo-web test",
    "start:node": "pnpm --filter @acme/demo-api start:node",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "lint-fix": "oxlint --fix && dprint fmt",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "docs:dev": "pnpm --filter @effect-assistant/docs dev",
    "docs:build": "pnpm --filter @effect-assistant/docs build"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.85.0",
    "dprint": "0.50.2",
    "effect": "4.0.0-rc.117",
    "oxlint": "1.85.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "effect": "4.0.0-rc.117",
      "typescript": "7.0.2"
    },
    "patchedDependencies": {
      "@effect-uai/core@0.12.0": "patches/@effect-uai__core@0.12.0.patch"
    }
  }
}
