{
  "name": "effect-assistant-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @acme/demo-api --filter @acme/demo-web dev",
    "build": "pnpm -r build",
    "lint": "vp lint",
    "test": "pnpm -r test",
    "start:node": "pnpm --filter @acme/demo-api start:node",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "lint-fix": "vp check --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "docs:dev": "pnpm --filter @effect-assistant/docs dev",
    "docs:build": "pnpm --filter @effect-assistant/docs build",
    "changeset": "changeset",
    "release": "pnpm --filter effect-assistant build && changeset publish",
    "test:contract": "pnpm --filter effect-assistant test:contract"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.85.0",
    "effect": "4.0.0-rc.117",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
