{
  "name": "effect-assistant",
  "version": "0.8.2",
  "description": "A colleague assistant on Effect: an append-only event log per chat, an interruptible agent loop, specialists, skills, and UI blocks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbrxnds/effect-assistant.git",
    "directory": "packages/effect-assistant"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./internal/*": null
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run --exclude test/contract.test.ts",
    "test:contract": "vp test run test/contract.test.ts"
  },
  "devDependencies": {
    "@effect/ai-anthropic": "4.0.0",
    "@effect/sql-sqlite-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "^22.15.3",
    "effect": "4.0.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  }
}
