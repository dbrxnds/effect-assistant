{
  "name": "effect-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A colleague assistant on Effect: an append-only event log per chat, an interruptible agent loop, specialists, skills, and UI blocks",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null
  },
  "dependencies": {
    "@effect-uai/core": "0.12.0",
    "effect": "4.0.0-rc.117",
    "nanoid": "^6.0.1"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.117",
    "@types/node": "^22.15.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "@effect-uai/anthropic": "0.12.0"
  },
  "sideEffects": []
}
